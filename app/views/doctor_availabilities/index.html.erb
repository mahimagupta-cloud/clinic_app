<div style="
  max-width: 1000px;
  margin: 40px auto;
  padding: 0 24px;
  font-family: Arial, sans-serif;
">

  <!-- Header -->
  <div style="
    background:white;
    padding:30px;
    border-radius:16px;
    box-shadow:0 4px 18px rgba(0,0,0,0.07);
    margin-bottom:30px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
  ">

    <div>

      <p style="
        margin:0 0 8px 0;
        color:#1976d2;
        font-size:13px;
        font-weight:bold;
        text-transform:uppercase;
        letter-spacing:0.6px;
      ">
        Doctor Portal
      </p>

      <h1 style="
        margin:0 0 8px 0;
        font-size:30px;
        color:#222;
      ">
        Doctor Availability
      </h1>

      <p style="
        margin:0;
        color:#777;
        font-size:15px;
      ">
        Manage the dates and hours when patients can book appointments.
      </p>

    </div>

    <%= link_to "＋ Add Availability",
        new_doctor_doctor_availability_path(@doctor),
        style: "
          display:inline-block;
          padding:12px 20px;
          background:#1976d2;
          color:white;
          text-decoration:none;
          border-radius:8px;
          font-size:14px;
          font-weight:bold;
          white-space:nowrap;
        " %>

  </div>


  <!-- Doctor Information -->
  <div style="
    background:white;
    padding:22px 25px;
    border-radius:14px;
    box-shadow:0 4px 18px rgba(0,0,0,0.06);
    margin-bottom:25px;
  ">

    <div style="
      display:flex;
      align-items:center;
      gap:16px;
    ">

      <div style="
        width:55px;
        height:55px;
        border-radius:50%;
        background:#e3f2fd;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:26px;
      ">
        👨‍⚕️
      </div>

      <div>

        <p style="
          margin:0 0 5px 0;
          color:#777;
          font-size:13px;
        ">
          Doctor
        </p>

        <h2 style="
          margin:0;
          font-size:20px;
          color:#222;
        ">
          Dr. <%= @doctor.name %>
        </h2>

        <% if @doctor.specialization.present? %>
          <p style="
            margin:5px 0 0 0;
            color:#1976d2;
            font-size:14px;
            font-weight:bold;
          ">
            <%= @doctor.specialization %>
          </p>
        <% end %>

      </div>

    </div>

  </div>


  <!-- Availability List -->
  <div style="
    background:white;
    padding:30px;
    border-radius:16px;
    box-shadow:0 4px 18px rgba(0,0,0,0.06);
  ">

    <div style="
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:25px;
    ">

      <div>

        <h2 style="
          margin:0 0 5px 0;
          font-size:22px;
          color:#222;
        ">
          Your Availability
        </h2>

        <p style="
          margin:0;
          color:#888;
          font-size:14px;
        ">
          Patients can book appointments during these dates and hours.
        </p>

      </div>

      <% if @doctor.doctor_availabilities.any? %>

        <span style="
          background:#e8f5e9;
          color:#2e7d32;
          padding:7px 13px;
          border-radius:20px;
          font-size:12px;
          font-weight:bold;
        ">
          <%= @doctor.doctor_availabilities.count %> Day(s)
        </span>

      <% end %>

    </div>


    <% if @doctor.doctor_availabilities.any? %>

      <% @doctor.doctor_availabilities.order(:date, :start_time).each do |availability| %>

        <div style="
          border:1px solid #e8e8e8;
          border-radius:12px;
          padding:20px;
          margin-bottom:15px;
          background:#fafcff;
          display:flex;
          justify-content:space-between;
          align-items:center;
          gap:20px;
        ">

          <!-- Date & Day -->
          <div style="
            display:flex;
            align-items:center;
            gap:16px;
            min-width:300px;
          ">

            <div style="
              width:50px;
              height:50px;
              border-radius:10px;
              background:#e3f2fd;
              display:flex;
              align-items:center;
              justify-content:center;
              font-size:23px;
            ">
              📅
            </div>

            <div>

              <!-- DATE -->
              <p style="
                margin:0 0 5px 0;
                color:#888;
                font-size:11px;
                text-transform:uppercase;
              ">
                Available Date
              </p>

              <h3 style="
                margin:0 0 5px 0;
                font-size:18px;
                color:#222;
              ">
                <% if availability.date.present? %>
                  <%= availability.date.strftime("%d %B %Y") %>
                <% else %>
                  Date not set
                <% end %>
              </h3>

              <!-- DAY -->
              <p style="
                margin:0;
                color:#1976d2;
                font-size:14px;
                font-weight:bold;
              ">
                <% if availability.day_of_week.present? %>
                  <%= Date::DAYNAMES[availability.day_of_week.to_i] %>
                <% end %>
              </p>

            </div>

          </div>


          <!-- Time -->
          <div style="
            text-align:center;
            min-width:180px;
          ">

            <p style="
              margin:0 0 5px 0;
              color:#888;
              font-size:12px;
              text-transform:uppercase;
            ">
              Available Hours
            </p>

            <p style="
              margin:0;
              color:#1976d2;
              font-size:16px;
              font-weight:bold;
            ">
              <%= availability.start_time.strftime("%I:%M %p") %>
              -
              <%= availability.end_time.strftime("%I:%M %p") %>
            </p>

          </div>


          <!-- Actions -->
          <div style="
            display:flex;
            gap:8px;
          ">

            <%= link_to "Edit",
                edit_doctor_doctor_availability_path(@doctor, availability),
                style: "
                  display:inline-block;
                  padding:9px 15px;
                  border:1px solid #1976d2;
                  color:#1976d2;
                  text-decoration:none;
                  border-radius:7px;
                  font-size:13px;
                  font-weight:bold;
                " %>

            <%= button_to "Delete",
                doctor_doctor_availability_path(@doctor, availability),
                method: :delete,
                data: {
                  turbo_confirm: "Are you sure you want to delete this availability?"
                },
                style: "
                  padding:9px 15px;
                  background:#fff;
                  color:#d32f2f;
                  border:1px solid #d32f2f;
                  border-radius:7px;
                  font-size:13px;
                  font-weight:bold;
                  cursor:pointer;
                " %>

          </div>

        </div>

      <% end %>


    <% else %>

      <!-- Empty State -->
      <div style="
        text-align:center;
        padding:60px 20px;
        border:1px dashed #d5d5d5;
        border-radius:12px;
        background:#fafafa;
      ">

        <div style="
          font-size:55px;
          margin-bottom:15px;
        ">
          🕐
        </div>

        <h3 style="
          margin:0 0 8px 0;
          color:#333;
          font-size:20px;
        ">
          No availability added
        </h3>

        <p style="
          margin:0 auto 20px auto;
          max-width:450px;
          color:#888;
          font-size:14px;
          line-height:1.6;
        ">
          Add your available dates and working hours so patients
          can see when they can book an appointment with you.
        </p>

        <%= link_to "＋ Add Your Availability",
            new_doctor_doctor_availability_path(@doctor),
            style: "
              display:inline-block;
              padding:11px 20px;
              background:#1976d2;
              color:white;
              text-decoration:none;
              border-radius:8px;
              font-size:14px;
              font-weight:bold;
            " %>

      </div>

    <% end %>

  </div>


  <!-- Back to Dashboard -->
  <div style="
    margin-top:25px;
    text-align:center;
  ">

    <%= link_to "← Back to Dashboard",
        doctor_dashboard_path,
        style: "
          color:#1976d2;
          text-decoration:none;
          font-size:14px;
          font-weight:bold;
        " %>

  </div>

</div>
