<div class="availability-page">
  <div class="availability-card">

    <h1>Add Doctor Availability</h1>

    <p class="doctor-name">
      Dr. <%= @doctor.name %>
    </p>

    <%= form_with model: [@doctor, @availability] do |form| %>

      <% if @availability.errors.any? %>
        <div class="error-messages">
          <% @availability.errors.full_messages.each do |message| %>
            <p><%= message %></p>
          <% end %>
        </div>
      <% end %>

      <div class="form-group">
        <%= form.label :date, "Available Date" %>
        <%= form.date_field :date, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :day_of_week, "Day of Week" %>
        <%= form.select :day_of_week,
          ["Monday", "Tuesday", "Wednesday", "Thursday",
           "Friday", "Saturday", "Sunday"],
          {},
          class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :start_time, "Start Time" %>
        <%= form.time_field :start_time, class: "form-input" %>
      </div>

      <div class="form-group">
        <%= form.label :end_time, "End Time" %>
        <%= form.time_field :end_time, class: "form-input" %>
      </div>

      <div class="form-actions">
        <%= form.submit "Save Availability", class: "btn-primary" %>

        <%= link_to "Back",
          doctor_doctor_availabilities_path(@doctor),
          class: "btn-secondary" %>
      </div>

    <% end %>

  </div>
</div>