<h1>Add Doctor Availability</h1>

<%= form_with model: [@doctor, @availability] do |form| %>

  <div>
    <%= form.label :day_of_week %>
    <%= form.text_field :day_of_week %>
  </div>

  <br>

  <div>
    <%= form.label :start_time %>
    <%= form.time_field :start_time %>
  </div>

  <br>

  <div>
    <%= form.label :end_time %>
    <%= form.time_field :end_time %>
  </div>

  <br>

  <%= form.submit "Save Availability" %>

<% end %>

<br>

<%= link_to "Back",
    doctor_doctor_availabilities_path(@doctor) %>
