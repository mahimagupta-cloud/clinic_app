<div class="availability-page">

  <div class="availability-wrapper">

    <!-- Header -->
    <div class="availability-header">
      <%= link_to "← Back to Availability",
          doctor_doctor_availabilities_path(@doctor),
          class: "back-link" %>

      <div class="header-icon">🗓️</div>

      <h1>Set Your Availability</h1>

      <p>
        Tell patients when you're available for appointments.
      </p>
    </div>


    <!-- Doctor -->
    <div class="doctor-card">
      <div class="doctor-avatar">
        <%= @doctor.name.to_s.first.upcase %>
      </div>

      <div>
        <span class="doctor-label">Doctor</span>
        <h2>Dr. <%= @doctor.name %></h2>

        <% if @doctor.specialization.present? %>
          <p><%= @doctor.specialization %></p>
        <% end %>
      </div>
    </div>


    <!-- Form Card -->
    <div class="availability-card">

      <div class="card-heading">
        <h2>Availability Details</h2>
        <p>Select the date and hours when you can accept appointments.</p>
      </div>


      <% if @availability.errors.any? %>
        <div class="error-messages">
          <div class="error-title">
            ⚠️ Please fix the following:
          </div>

          <ul>
            <% @availability.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>


      <%= form_with model: [@doctor, @availability] do |form| %>

        <!-- Date -->
        <div class="form-group">
          <%= form.label :date, "Available Date" %>

          <div class="input-wrapper">
            <span class="input-icon">📅</span>

            <%= form.date_field :date,
                class: "form-input",
                min: Date.current %>
          </div>

          <span class="field-help">
            Choose the day you want to accept appointments.
          </span>
        </div>


        <!-- Time -->
        <div class="time-section">

          <div class="section-label">
            <span>⏰</span>
            Appointment Hours
          </div>

          <div class="time-grid">

            <div class="form-group">
              <%= form.label :start_time, "Start Time" %>

              <div class="input-wrapper">
                <span class="input-icon">🕐</span>

                <%= form.time_field :start_time,
                    class: "form-input" %>
              </div>
            </div>


            <div class="time-arrow">
              →
            </div>


            <div class="form-group">
              <%= form.label :end_time, "End Time" %>

              <div class="input-wrapper">
                <span class="input-icon">🕐</span>

                <%= form.time_field :end_time,
                    class: "form-input" %>
              </div>
            </div>

          </div>

          <span class="field-help">
            Patients will be able to book appointments within these hours.
          </span>

        </div>


        <!-- Actions -->
        <div class="form-actions">

          <%= link_to "Cancel",
              doctor_doctor_availabilities_path(@doctor),
              class: "btn-secondary" %>

          <%= form.submit "Save Availability",
              class: "btn-primary" %>

        </div>

      <% end %>

    </div>


    <!-- Info -->
    <div class="availability-tip">
      <span class="tip-icon">💡</span>

      <div>
        <strong>Tip</strong>
        <p>
          Make sure your availability gives patients enough time
          to book their appointments.
        </p>
      </div>
    </div>

  </div>

</div>


<style>
  .availability-page {
    min-height: 100vh;
    background: #f6f8fb;
    padding: 40px 20px 70px;
  }

  .availability-wrapper {
    max-width: 760px;
    margin: 0 auto;
  }

  .availability-header {
    text-align: center;
    margin-bottom: 28px;
    position: relative;
  }

  .back-link {
    display: inline-block;
    color: #475569;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 24px;
  }

  .back-link:hover {
    color: #2563eb;
  }

  .header-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 16px;
    border-radius: 18px;
    background: #e0ecff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
  }

  .availability-header h1 {
    margin: 0;
    color: #0f172a;
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .availability-header p {
    margin: 10px 0 0;
    color: #64748b;
    font-size: 15px;
  }

  .doctor-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 18px 20px;
    margin-bottom: 18px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
  }

  .doctor-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #2563eb;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    font-weight: 800;
    flex-shrink: 0;
  }

  .doctor-label {
    display: block;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    margin-bottom: 3px;
  }

  .doctor-card h2 {
    margin: 0;
    color: #0f172a;
    font-size: 18px;
  }

  .doctor-card p {
    margin: 4px 0 0;
    color: #64748b;
    font-size: 13px;
  }

  .availability-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 30px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
  }

  .card-heading {
    margin-bottom: 28px;
  }

  .card-heading h2 {
    margin: 0 0 6px;
    color: #0f172a;
    font-size: 20px;
  }

  .card-heading p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
  }

  .error-messages {
    background: #fff1f2;
    border: 1px solid #fecdd3;
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 24px;
    color: #be123c;
  }

  .error-title {
    font-weight: 700;
    margin-bottom: 6px;
  }

  .error-messages ul {
    margin: 5px 0 0 20px;
    padding: 0;
  }

  .error-messages li {
    margin: 3px 0;
    font-size: 13px;
  }

  .form-group {
    margin-bottom: 24px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    color: #334155;
    font-size: 14px;
    font-weight: 700;
  }

  .input-wrapper {
    position: relative;
  }

  .input-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 17px;
    pointer-events: none;
  }

  .form-input {
    width: 100%;
    box-sizing: border-box;
    height: 48px;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 0 14px 0 44px;
    background: #fff;
    color: #0f172a;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-input:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  }

  .field-help {
    display: block;
    margin-top: 7px;
    color: #94a3b8;
    font-size: 12px;
  }

  .time-section {
    border-top: 1px solid #e2e8f0;
    padding-top: 24px;
    margin-top: 4px;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #334155;
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .time-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    gap: 14px;
  }

  .time-grid .form-group {
    margin-bottom: 0;
  }

  .time-arrow {
    color: #94a3b8;
    font-size: 20px;
    padding-bottom: 13px;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    border-top: 1px solid #e2e8f0;
    padding-top: 24px;
    margin-top: 30px;
  }

  .btn-primary,
  .btn-secondary {
    min-height: 46px;
    padding: 0 22px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .btn-primary {
    border: 0;
    background: #2563eb;
    color: white;
  }

  .btn-primary:hover {
    background: #1d4ed8;
  }

  .btn-secondary {
    border: 1px solid #cbd5e1;
    background: white;
    color: #475569;
  }

  .btn-secondary:hover {
    background: #f8fafc;
  }

  .availability-tip {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-top: 18px;
    padding: 16px 18px;
    border-radius: 14px;
    background: #eff6ff;
    border: 1px solid #dbeafe;
  }

  .tip-icon {
    font-size: 18px;
  }

  .availability-tip strong {
    color: #1e3a8a;
    font-size: 13px;
  }

  .availability-tip p {
    margin: 4px 0 0;
    color: #475569;
    font-size: 12px;
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .availability-page {
      padding: 24px 14px 50px;
    }

    .availability-header h1 {
      font-size: 26px;
    }

    .availability-card {
      padding: 22px 18px;
    }

    .time-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .time-arrow {
      display: none;
    }

    .time-grid .form-group + .form-group {
      margin-top: 18px;
    }

    .form-actions {
      flex-direction: column-reverse;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
    }
  }
</style>
