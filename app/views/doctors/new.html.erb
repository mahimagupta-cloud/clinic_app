<h1>New Doctor</h1>

<%= form_with model: @doctor do |form| %>

  <% if @doctor.errors.any? %>
    <div>
      <h2><%= pluralize(@doctor.errors.count, "error") %> prevented saving:</h2>

      <ul>
        <% @doctor.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :clinic_id, "Clinic" %>
    <%= form.collection_select :clinic_id, Clinic.all, :id, :name,
        prompt: "Select Clinic" %>
  </div>

  <div>
    <%= form.label :name, "Doctor Name" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :specialization %>
    <%= form.text_field :specialization %>
  </div>

  <div>
    <%= form.label :experience %>
    <%= form.number_field :experience %>
  </div>

  <div>
    <%= form.label :bio %>
    <%= form.text_area :bio %>
  </div>

  <div>
    <%= form.label :consultation_fee %>
    <%= form.number_field :consultation_fee %>
  </div>

  <div>
    <%= form.submit "Create Doctor" %>
  </div>

<% end %>

<br>

<%= link_to "Back to Doctors", doctors_path %>
