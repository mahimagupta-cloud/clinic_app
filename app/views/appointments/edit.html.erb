
<h1>Edit Appointment</h1>

<%= form_with model: @appointment do |form| %>

  <% if @appointment.errors.any? %>
    <div>
      <h2><%= pluralize(@appointment.errors.count, "error") %> prevented the update:</h2>

      <ul>
        <% @appointment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :doctor_id, "Doctor" %>
    <%= form.collection_select :doctor_id, Doctor.all, :id, :name %>
  </div>

  <div>
    <%= form.label :patient_id, "Patient" %>
    <%= form.collection_select :patient_id, Patient.all, :id, :name %>
  </div>

  <div>
    <%= form.label :scheduled_at, "Appointment Time" %>
    <%= form.datetime_local_field :scheduled_at %>
  </div>

  <div>
    <%= form.label :status, "Status" %>
    <%= form.select :status, Appointment.statuses.keys.map { |status| [status.humanize, status] } %>
  </div>

  <div>
    <%= form.submit "Update Appointment" %>
  </div>

<% end %>

<%= link_to "Back", appointment_path(@appointment) %>

