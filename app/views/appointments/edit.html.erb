<h1>Edit Appointment</h1>

<div>
  <p>
    <strong>Doctor:</strong>
    <%= @appointment.doctor.name %>
  </p>

  <p>
    <strong>Patient:</strong>
    <%= @appointment.patient.name %>
  </p>

  <p>
    <strong>Appointment Date & Time:</strong>
    <%= @appointment.scheduled_at.strftime("%d %B %Y, %I:%M %p") %>
  </p>

  <%= form_with model: @appointment do |form| %>

    <% if @appointment.errors.any? %>
      <div>
        <h3>
          <%= pluralize(@appointment.errors.count, "error") %>
          prevented this appointment from being updated:
        </h3>

        <ul>
          <% @appointment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :status, "Status" %>

      <%= form.select :status,
          Appointment.statuses.keys.map { |status| [status.humanize, status] } %>
    </div>

    <br>

    <%= form.submit "Update Appointment" %>

  <% end %>

  <br>

  <%= link_to "Back", appointment_path(@appointment) %>
</div>