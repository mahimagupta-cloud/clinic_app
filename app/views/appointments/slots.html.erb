<h1>Available Slots</h1>

<h2><%= @doctor.name %></h2>

<p>
  Date: <%= @date.strftime("%d %B %Y") %>
</p>

<% if @slots.any? %>

  <% @slots.each do |slot| %>

    <div style="
      margin-bottom: 15px;
      padding: 15px;
      border: 1px solid #ddd;
      border-radius: 8px;
    ">

      <strong>
        <%= slot.strftime("%I:%M %p") %>
      </strong>

      <%= form_with model: Appointment.new,
          url: appointments_path,
          method: :post,
          local: true do |form| %>

        <%= form.hidden_field :doctor_id,
            value: @doctor.id %>

        <%= form.hidden_field :scheduled_at,
            value: slot.strftime("%Y-%m-%dT%H:%M") %>

        <%= form.submit "Book Appointment" %>

      <% end %>

    </div>

  <% end %>

<% else %>

  <p>No slots available for this date.</p>

<% end %>