<h1>New Appointment</h1>

<%= form_with model: @appointment do |form| %>

  <% if @appointment.errors.any? %>
    <div>
      <h2>
        <%= pluralize(@appointment.errors.count, "error") %>
        prevented this appointment from being saved:
      </h2>

      <ul>
        <% @appointment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :doctor_id, "Doctor" %>

    <%= form.collection_select :doctor_id,
        Doctor.all,
        :id,
        :name,
        prompt: "Select Doctor" %>
  </div>

  <div>
    <%= form.label :patient_id, "Patient" %>

    <%= form.collection_select :patient_id,
        Patient.all,
        :id,
        :name,
        prompt: "Select Patient" %>
  </div>

  <div>
    <%= form.label :scheduled_at, "Appointment Time" %>

  <%= form.datetime_local_field :scheduled_at,
    value: @appointment.scheduled_at&.strftime("%Y-%m-%dT%H:%M") %>
  </div>

  <div>
    <%= form.submit "Book Appointment" %>
  </div>

<% end %>

<%= link_to "Back to Appointments", appointments_path %>