<h1>Confirm Appointment</h1>

<%= form_with model: @appointment do |form| %>

  <% if @appointment.errors.any? %>
    <div>
      <h2>
        <%= pluralize(@appointment.errors.count, "error") %>
        prevented this appointment from being saved:
      </h2>

      <ul>
        <% @appointment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <strong>Doctor:</strong>
    <%= @appointment.doctor&.name %>
  </div>

  <br>

  <div>
    <strong>Patient:</strong>
    <%= current_user.patient&.name %>
  </div>

  <br>

  <div>
    <strong>Appointment Date & Time:</strong>
    <%= @appointment.scheduled_at&.strftime("%d %B %Y, %I:%M %p") %>
  </div>

  <br>

  <%= form.hidden_field :doctor_id, value: @appointment.doctor_id %>

  <%= form.hidden_field :scheduled_at,
      value: @appointment.scheduled_at&.strftime("%Y-%m-%dT%H:%M") %>

  <%= form.submit "Confirm Appointment" %>

<% end %>

<br>

<%= link_to "Back to Available Slots",
    slots_appointments_path(
      doctor_id: @appointment.doctor_id,
      date: @appointment.scheduled_at&.to_date
    ) %>