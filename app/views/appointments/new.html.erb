<div style="
  max-width: 650px;
  margin: 50px auto;
  padding: 0 20px;
  font-family: Arial, sans-serif;
">

  <div style="
    background: white;
    border-radius: 12px;
    padding: 35px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.10);
    border: 1px solid #e5e7eb;
  ">

    <h1 style="
      margin-top: 0;
      margin-bottom: 25px;
      font-size: 28px;
      color: #1f2937;
    ">
      Confirm Appointment
    </h1>

    <% if @appointment.errors.any? %>

      <div style="
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-left: 5px solid #dc2626;
        border-radius: 8px;
        padding: 16px 18px;
        margin-bottom: 25px;
      ">

        <h3 style="
          margin: 0 0 10px 0;
          color: #b91c1c;
          font-size: 17px;
        ">
          Appointment could not be booked
        </h3>

        <p style="
          margin: 0 0 8px 0;
          color: #7f1d1d;
        ">
          Please fix the following:
        </p>

        <ul style="
          margin: 0;
          padding-left: 20px;
          color: #991b1b;
        ">
          <% @appointment.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>

      </div>

    <% end %>


    <!-- Appointment Details -->

    <div style="
      background: #f9fafb;
      border-radius: 10px;
      padding: 22px;
      margin-bottom: 25px;
    ">

      <h2 style="
        margin-top: 0;
        margin-bottom: 20px;
        font-size: 19px;
        color: #374151;
      ">
        Appointment Details
      </h2>

      <div style="
        display: grid;
        gap: 14px;
      ">

        <div>
          <span style="color: #6b7280;">Doctor</span>
          <div style="
            font-weight: 600;
            color: #111827;
            margin-top: 3px;
          ">
            <%= @appointment.doctor&.name %>
          </div>
        </div>

        <div>
          <span style="color: #6b7280;">Patient</span>
          <div style="
            font-weight: 600;
            color: #111827;
            margin-top: 3px;
          ">
            <%= @appointment.patient&.name %>
          </div>
        </div>

        <div>
          <span style="color: #6b7280;">Appointment Date & Time</span>
          <div style="
            font-weight: 600;
            color: #111827;
            margin-top: 3px;
          ">
            <%= @appointment.scheduled_at&.strftime("%d %B %Y, %I:%M %p") %>
          </div>
        </div>

      </div>

    </div>


    <!-- Buttons -->

    <div style="
      display: flex;
      gap: 12px;
      align-items: center;
    ">

      <%= form_with model: @appointment, local: true do |form| %>

        <%= form.hidden_field :doctor_id %>
        <%= form.hidden_field :patient_id %>
        <%= form.hidden_field :scheduled_at %>

        <%= form.submit "Confirm Appointment",
          style: "
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 7px;
            padding: 11px 20px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
          " %>

      <% end %>

      <%= link_to "Back to Available Slots",
          url_for(
            controller: "appointments",
            action: "slots",
            doctor_id: @appointment.doctor_id,
            date: @appointment.scheduled_at&.to_date
          ),
          style: "
            color: #374151;
            text-decoration: none;
            border: 1px solid #d1d5db;
            border-radius: 7px;
            padding: 10px 18px;
            font-size: 15px;
          " %>

    </div>

  </div>

</div>