
<div style="
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
">

  <h1>Doctor Dashboard</h1>

  <%= button_to "Logout",
      destroy_user_session_path,
      method: :delete,
      style: "
        padding: 10px 18px;
        background: #d32f2f;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
      " %>

</div>
<h1>Doctor Dashboard</h1>

<p>
  Welcome, Dr. <%= @doctor.name %>
</p>
<%= link_to "Manage Availability",
    doctor_doctor_availabilities_path(@doctor),
    style: "display: inline-block; padding: 10px 15px; background: #1769aa; color: white; text-decoration: none; border-radius: 6px;" %>
<hr>

<h2>Upcoming Appointments</h2>

<% if @upcoming_appointments.any? %>

  <% @upcoming_appointments.each do |appointment| %>
    <div>
      <strong>Patient:</strong>
      <%= appointment.patient.name %>
      <br>

      <strong>Date & Time:</strong>
      <%= appointment.scheduled_at.strftime("%d %b %Y, %I:%M %p") %>
      <br>

      <strong>Status:</strong>
      <%= appointment.status %>
      <br><br>

      <%= button_to "Completed",
          doctor_appointment_status_path(appointment, status: "completed"),
          method: :patch %>

      <%= button_to "Cancelled",
          doctor_appointment_status_path(appointment, status: "cancelled"),
          method: :patch %>

      <%= button_to "No Show",
          doctor_appointment_status_path(appointment, status: "no_show"),
          method: :patch %>
    </div>

    <hr>
  <% end %>

<% else %>

  <p>No upcoming appointments.</p>

<% end %>


<h2>Past Appointments</h2>

<% if @past_appointments.any? %>

  <% @past_appointments.each do |appointment| %>
    <div>
      <strong>Patient:</strong>
      <%= appointment.patient.name %>
      <br>

      <strong>Date & Time:</strong>
      <%= appointment.scheduled_at.strftime("%d %b %Y, %I:%M %p") %>
      <br>

      <strong>Status:</strong>
      <%= appointment.status %>
    </div>

    <hr>
  <% end %>

<% else %>

  <p>No past appointments.</p>

<% end %>