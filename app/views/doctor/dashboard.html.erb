<div style="
  max-width:1200px;
  margin:0 auto;
  padding:40px 24px;
  font-family:Arial,sans-serif;
">

  <!-- HEADER -->
  <div style="
    background:white;
    border:1px solid #e5e7eb;
    border-radius:18px;
    padding:32px;
    margin-bottom:28px;
    box-shadow:0 4px 15px rgba(0,0,0,0.05);
  ">

    <div style="
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:20px;
      flex-wrap:wrap;
    ">

      <div>

        <p style="
          margin:0 0 8px;
          color:#1976d2;
          font-size:13px;
          font-weight:700;
          letter-spacing:0.8px;
          text-transform:uppercase;
        ">
          Doctor Portal
        </p>

        <h1 style="
          margin:0 0 8px;
          font-size:32px;
          color:#1f2937;
        ">
          Welcome, Dr. <%= @doctor.name %>
        </h1>

        <p style="
          margin:0;
          color:#6b7280;
          font-size:15px;
        ">
          Manage your appointments and availability from one place.
        </p>

      </div>


      <!-- Doctor Info -->
      <div style="
        display:flex;
        align-items:center;
        gap:14px;
        padding:12px 16px;
        background:#f8fafc;
        border:1px solid #e5e7eb;
        border-radius:12px;
      ">

        <div style="
          width:48px;
          height:48px;
          border-radius:50%;
          background:#e3f2fd;
          display:flex;
          align-items:center;
          justify-content:center;
          font-size:24px;
        ">
          👨‍⚕️
        </div>

        <div>

          <div style="
            font-size:14px;
            font-weight:700;
            color:#1f2937;
          ">
            Dr. <%= @doctor.name %>
          </div>

          <div style="
            margin-top:3px;
            font-size:13px;
            color:#6b7280;
          ">
            <%= @doctor.specialization %>
          </div>

        </div>

      </div>

    </div>

  </div>


  <!-- STATISTICS -->
  <div style="
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:18px;
    margin-bottom:28px;
  ">

    <!-- UPCOMING -->
    <div style="
      background:white;
      border:1px solid #e5e7eb;
      border-radius:16px;
      padding:23px;
      box-shadow:0 3px 12px rgba(0,0,0,0.05);
    ">

      <div style="
        display:flex;
        justify-content:space-between;
        align-items:center;
        margin-bottom:18px;
      ">

        <div style="
          width:46px;
          height:46px;
          border-radius:12px;
          background:#e3f2fd;
          display:flex;
          align-items:center;
          justify-content:center;
          font-size:23px;
        ">
          📅
        </div>

        <span style="
          font-size:12px;
          font-weight:700;
          color:#1976d2;
          background:#e3f2fd;
          padding:6px 10px;
          border-radius:20px;
        ">
          UPCOMING
        </span>

      </div>

      <p style="
        margin:0 0 6px;
        color:#6b7280;
        font-size:14px;
      ">
        Upcoming Appointments
      </p>

      <h2 style="
        margin:0;
        font-size:32px;
        color:#1f2937;
      ">
        <%= @upcoming_appointments.count %>
      </h2>

    </div>


    <!-- PAST -->
    <div style="
      background:white;
      border:1px solid #e5e7eb;
      border-radius:16px;
      padding:23px;
      box-shadow:0 3px 12px rgba(0,0,0,0.05);
    ">

      <div style="
        display:flex;
        justify-content:space-between;
        align-items:center;
        margin-bottom:18px;
      ">

        <div style="
          width:46px;
          height:46px;
          border-radius:12px;
          background:#e8f5e9;
          display:flex;
          align-items:center;
          justify-content:center;
          font-size:23px;
        ">
          ✅
        </div>

        <span style="
          font-size:12px;
          font-weight:700;
          color:#2e7d32;
          background:#e8f5e9;
          padding:6px 10px;
          border-radius:20px;
        ">
          HISTORY
        </span>

      </div>

      <p style="
        margin:0 0 6px;
        color:#6b7280;
        font-size:14px;
      ">
        Past Appointments
      </p>

      <h2 style="
        margin:0;
        font-size:32px;
        color:#1f2937;
      ">
        <%= @past_appointments.count %>
      </h2>

    </div>


    <!-- TOTAL -->
    <div style="
      background:white;
      border:1px solid #e5e7eb;
      border-radius:16px;
      padding:23px;
      box-shadow:0 3px 12px rgba(0,0,0,0.05);
    ">

      <div style="
        display:flex;
        justify-content:space-between;
        align-items:center;
        margin-bottom:18px;
      ">

        <div style="
          width:46px;
          height:46px;
          border-radius:12px;
          background:#f3e8ff;
          display:flex;
          align-items:center;
          justify-content:center;
          font-size:23px;
        ">
          📊
        </div>

        <span style="
          font-size:12px;
          font-weight:700;
          color:#7e22ce;
          background:#f3e8ff;
          padding:6px 10px;
          border-radius:20px;
        ">
          ALL TIME
        </span>

      </div>

      <p style="
        margin:0 0 6px;
        color:#6b7280;
        font-size:14px;
      ">
        Total Appointments
      </p>

      <h2 style="
        margin:0;
        font-size:32px;
        color:#1f2937;
      ">
        <%= @upcoming_appointments.count + @past_appointments.count %>
      </h2>

    </div>

  </div>


  <!-- UPCOMING APPOINTMENTS -->
  <div style="
    background:white;
    border:1px solid #e5e7eb;
    border-radius:18px;
    padding:30px;
    margin-bottom:28px;
    box-shadow:0 4px 15px rgba(0,0,0,0.05);
  ">

    <div style="
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:15px;
      margin-bottom:24px;
      flex-wrap:wrap;
    ">

      <div>

        <h2 style="
          margin:0 0 5px;
          font-size:23px;
          color:#1f2937;
        ">
          Upcoming Appointments
        </h2>

        <p style="
          margin:0;
          color:#6b7280;
          font-size:14px;
        ">
          Your scheduled patient consultations.
        </p>

      </div>

      <div style="
        background:#e3f2fd;
        color:#1976d2;
        padding:8px 14px;
        border-radius:20px;
        font-size:13px;
        font-weight:700;
      ">
        <%= @upcoming_appointments.count %>
        <%= @upcoming_appointments.count == 1 ? "Appointment" : "Appointments" %>
      </div>

    </div>


    <% if @upcoming_appointments.any? %>

      <% @upcoming_appointments.each do |appointment| %>

        <div style="
          border:1px solid #e5e7eb;
          border-radius:14px;
          padding:20px;
          margin-bottom:14px;
          background:#fbfdff;
        ">

          <div style="
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:20px;
            flex-wrap:wrap;
          ">

            <!-- PATIENT -->
            <div style="
              display:flex;
              align-items:center;
              gap:15px;
            ">

              <div style="
                width:54px;
                height:54px;
                border-radius:50%;
                background:#e3f2fd;
                display:flex;
                align-items:center;
                justify-content:center;
                font-size:24px;
                flex-shrink:0;
              ">
                👤
              </div>

              <div>

                <h3 style="
                  margin:0 0 6px;
                  font-size:18px;
                  color:#1f2937;
                ">
                  <%= appointment.patient.name %>
                </h3>

                <p style="
                  margin:0 0 4px;
                  color:#6b7280;
                  font-size:14px;
                ">
                  📞 <%= appointment.patient.phone %>
                </p>

                <p style="
                  margin:0;
                  color:#6b7280;
                  font-size:13px;
                ">
                  🩺 Consultation
                </p>

              </div>

            </div>


            <!-- DATE/TIME -->
            <div style="
              display:flex;
              align-items:center;
              gap:22px;
              flex-wrap:wrap;
            ">

              <div>

                <div style="
                  font-size:13px;
                  color:#6b7280;
                  margin-bottom:5px;
                ">
                  DATE
                </div>

                <div style="
                  font-size:15px;
                  font-weight:700;
                  color:#1f2937;
                ">
                  <%= appointment.scheduled_at.strftime("%d %B %Y") %>
                </div>

              </div>


              <div>

                <div style="
                  font-size:13px;
                  color:#6b7280;
                  margin-bottom:5px;
                ">
                  TIME
                </div>

                <div style="
                  font-size:15px;
                  font-weight:700;
                  color:#1f2937;
                ">
                  <%= appointment.scheduled_at.strftime("%I:%M %p") %>
                </div>

              </div>


              <span style="
                display:inline-block;
                padding:7px 13px;
                background:#e8f5e9;
                color:#2e7d32;
                border-radius:20px;
                font-size:12px;
                font-weight:700;
              ">
                <%= appointment.status.humanize %>
              </span>

            </div>

          </div>

        </div>

      <% end %>


    <% else %>

      <!-- EMPTY UPCOMING -->
      <div style="
        text-align:center;
        padding:55px 20px;
        border:1px dashed #d1d5db;
        border-radius:14px;
        background:#f9fafb;
      ">

        <div style="
          width:65px;
          height:65px;
          margin:0 auto 16px;
          border-radius:50%;
          background:#e3f2fd;
          display:flex;
          align-items:center;
          justify-content:center;
          font-size:30px;
        ">
          📅
        </div>

        <h3 style="
          margin:0 0 8px;
          color:#1f2937;
          font-size:18px;
        ">
          No upcoming appointments
        </h3>

        <p style="
          margin:0;
          color:#6b7280;
          font-size:14px;
        ">
          New patient appointments will appear here.
        </p>

      </div>

    <% end %>

  </div>


  <!-- PAST APPOINTMENTS -->
  <div style="
    background:white;
    border:1px solid #e5e7eb;
    border-radius:18px;
    padding:30px;
    margin-bottom:28px;
    box-shadow:0 4px 15px rgba(0,0,0,0.05);
  ">

    <div style="
      margin-bottom:24px;
    ">

      <h2 style="
        margin:0 0 5px;
        font-size:23px;
        color:#1f2937;
      ">
        Past Appointments
      </h2>

      <p style="
        margin:0;
        color:#6b7280;
        font-size:14px;
      ">
        Previous patient consultations and appointment history.
      </p>

    </div>


    <% if @past_appointments.any? %>

      <% @past_appointments.each do |appointment| %>

        <div style="
          border:1px solid #e5e7eb;
          border-radius:13px;
          padding:19px;
          margin-bottom:12px;
          background:#fafafa;
        ">

          <div style="
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:15px;
            flex-wrap:wrap;
          ">

            <div style="
              display:flex;
              align-items:center;
              gap:14px;
            ">

              <div style="
                width:45px;
                height:45px;
                border-radius:50%;
                background:#f1f5f9;
                display:flex;
                align-items:center;
                justify-content:center;
                font-size:20px;
              ">
                👤
              </div>

              <div>

                <h3 style="
                  margin:0 0 5px;
                  font-size:16px;
                  color:#1f2937;
                ">
                  <%= appointment.patient.name %>
                </h3>

                <p style="
                  margin:0;
                  color:#6b7280;
                  font-size:13px;
                ">
                  <%= appointment.scheduled_at.strftime("%d %B %Y") %>
                  &nbsp; • &nbsp;
                  <%= appointment.scheduled_at.strftime("%I:%M %p") %>
                </p>

              </div>

            </div>


            <span style="
              display:inline-block;
              padding:7px 13px;
              background:#f1f5f9;
              color:#475569;
              border-radius:20px;
              font-size:12px;
              font-weight:700;
            ">
              <%= appointment.status.humanize %>
            </span>

          </div>

        </div>

      <% end %>


    <% else %>

      <!-- EMPTY PAST -->
      <div style="
        text-align:center;
        padding:45px 20px;
        border:1px dashed #d1d5db;
        border-radius:14px;
        background:#f9fafb;
      ">

        <div style="
          width:60px;
          height:60px;
          margin:0 auto 14px;
          border-radius:50%;
          background:#f1f5f9;
          display:flex;
          align-items:center;
          justify-content:center;
          font-size:28px;
        ">
          📋
        </div>

        <h3 style="
          margin:0 0 8px;
          color:#1f2937;
          font-size:17px;
        ">
          No past appointments
        </h3>

        <p style="
          margin:0;
          color:#6b7280;
          font-size:14px;
        ">
          Completed and previous appointments will appear here.
        </p>

      </div>

    <% end %>

  </div>


  <!-- AVAILABILITY CTA -->
  <div style="
    background:#1976d2;
    color:white;
    padding:30px;
    border-radius:18px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    flex-wrap:wrap;
    box-shadow:0 5px 18px rgba(25,118,210,0.2);
  ">

    <div>

      <p style="
        margin:0 0 7px;
        font-size:12px;
        font-weight:700;
        letter-spacing:0.6px;
        text-transform:uppercase;
        opacity:0.85;
      ">
        Availability
      </p>

      <h2 style="
        margin:0 0 8px;
        font-size:21px;
      ">
        Keep your availability updated
      </h2>

      <p style="
        margin:0;
        opacity:0.9;
        font-size:14px;
        line-height:1.5;
      ">
        Patients can only book appointments during your available hours.
      </p>

    </div>


    <%= link_to "Manage Availability →",
        doctor_doctor_availabilities_path(@doctor),
        style: "
          display:inline-block;
          padding:12px 20px;
          background:white;
          color:#1976d2;
          text-decoration:none;
          border-radius:9px;
          font-size:14px;
          font-weight:700;
        " %>

  </div>

</div>