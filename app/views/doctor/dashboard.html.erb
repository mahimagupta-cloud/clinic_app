<div style="
  max-width: 1200px;
  margin: 40px auto;
  padding: 0 24px;
  font-family: Arial, sans-serif;
">

  <!-- Header -->
  <div style="
    background:white;
    padding:30px;
    border-radius:16px;
    box-shadow:0 4px 18px rgba(0,0,0,0.07);
    margin-bottom:30px;
  ">

    <p style="
      margin:0 0 8px 0;
      color:#1976d2;
      font-size:14px;
      font-weight:bold;
      text-transform:uppercase;
      letter-spacing:0.5px;
    ">
      Doctor Portal
    </p>

    <h1 style="
      margin:0 0 8px 0;
      font-size:32px;
      color:#222;
    ">
      Welcome, Dr. <%= @doctor.name %>
    </h1>

    <p style="
      margin:0;
      color:#777;
      font-size:15px;
    ">
      Manage your appointments and availability
    </p>

  </div>


  <!-- Statistics -->
  <div style="
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:20px;
    margin-bottom:30px;
  ">

    <!-- Upcoming -->
    <div style="
      background:white;
      padding:25px;
      border-radius:14px;
      box-shadow:0 4px 18px rgba(0,0,0,0.06);
      border-left:5px solid #1976d2;
    ">

      <div style="font-size:30px; margin-bottom:10px;">
        📅
      </div>

      <p style="
        margin:0 0 5px 0;
        color:#777;
        font-size:14px;
      ">
        Upcoming Appointments
      </p>

      <h2 style="
        margin:0;
        font-size:30px;
        color:#222;
      ">
        <%= @upcoming_appointments.count %>
      </h2>

    </div>


    <!-- Past -->
    <div style="
      background:white;
      padding:25px;
      border-radius:14px;
      box-shadow:0 4px 18px rgba(0,0,0,0.06);
      border-left:5px solid #43a047;
    ">

      <div style="font-size:30px; margin-bottom:10px;">
        ✅
      </div>

      <p style="
        margin:0 0 5px 0;
        color:#777;
        font-size:14px;
      ">
        Past Appointments
      </p>

      <h2 style="
        margin:0;
        font-size:30px;
        color:#222;
      ">
        <%= @past_appointments.count %>
      </h2>

    </div>


    <!-- Total -->
    <div style="
      background:white;
      padding:25px;
      border-radius:14px;
      box-shadow:0 4px 18px rgba(0,0,0,0.06);
      border-left:5px solid #8e44ad;
    ">

      <div style="font-size:30px; margin-bottom:10px;">
        📊
      </div>

      <p style="
        margin:0 0 5px 0;
        color:#777;
        font-size:14px;
      ">
        Total Appointments
      </p>

      <h2 style="
        margin:0;
        font-size:30px;
        color:#222;
      ">
        <%= @upcoming_appointments.count + @past_appointments.count %>
      </h2>

    </div>

  </div>


  <!-- Upcoming Appointments -->
  <div style="
    background:white;
    padding:30px;
    border-radius:16px;
    box-shadow:0 4px 18px rgba(0,0,0,0.06);
    margin-bottom:30px;
  ">

    <div style="
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:25px;
    ">

      <div>

        <h2 style="
          margin:0 0 5px 0;
          font-size:23px;
          color:#222;
        ">
          Upcoming Appointments
        </h2>

        <p style="
          margin:0;
          color:#888;
          font-size:14px;
        ">
          Your scheduled consultations
        </p>

      </div>

      <div style="
        background:#e3f2fd;
        color:#1976d2;
        padding:8px 14px;
        border-radius:20px;
        font-size:13px;
        font-weight:bold;
      ">
        <%= @upcoming_appointments.count %> Upcoming
      </div>

    </div>


    <% if @upcoming_appointments.any? %>

      <% @upcoming_appointments.each do |appointment| %>

        <div style="
          border:1px solid #e8e8e8;
          border-radius:12px;
          padding:22px;
          margin-bottom:15px;
          display:flex;
          justify-content:space-between;
          align-items:center;
          background:#fafcff;
        ">

          <!-- Patient -->
          <div style="
            display:flex;
            align-items:center;
            gap:18px;
          ">

            <div style="
              width:55px;
              height:55px;
              border-radius:50%;
              background:#e3f2fd;
              display:flex;
              align-items:center;
              justify-content:center;
              font-size:25px;
            ">
              👤
            </div>

            <div>

              <h3 style="
                margin:0 0 6px 0;
                font-size:18px;
                color:#222;
              ">
                <%= appointment.patient.name %>
              </h3>

              <p style="
                margin:0 0 4px 0;
                color:#777;
                font-size:14px;
              ">
                📞 <%= appointment.patient.phone %>
              </p>

              <p style="
                margin:0;
                color:#777;
                font-size:14px;
              ">
                🩺 Consultation
              </p>

            </div>

          </div>


          <!-- Date & Time -->
          <div style="
            text-align:right;
          ">

            <p style="
              margin:0 0 6px 0;
              color:#1976d2;
              font-weight:bold;
              font-size:15px;
            ">
              <%= appointment.scheduled_at.strftime("%d %B %Y") %>
            </p>

            <p style="
              margin:0 0 10px 0;
              color:#555;
              font-size:14px;
            ">
              🕐 <%= appointment.scheduled_at.strftime("%I:%M %p") %>
            </p>

            <span style="
              display:inline-block;
              padding:5px 12px;
              background:#e8f5e9;
              color:#2e7d32;
              border-radius:20px;
              font-size:12px;
              font-weight:bold;
            ">
              <%= appointment.status.humanize %>
            </span>

          </div>

        </div>

      <% end %>

    <% else %>

      <!-- Empty Upcoming State -->
      <div style="
        text-align:center;
        padding:50px 20px;
        border:1px dashed #ddd;
        border-radius:12px;
        background:#fafafa;
      ">

        <div style="
          font-size:50px;
          margin-bottom:15px;
        ">
          📅
        </div>

        <h3 style="
          margin:0 0 8px 0;
          color:#333;
        ">
          No upcoming appointments
        </h3>

        <p style="
          margin:0;
          color:#888;
          font-size:14px;
        ">
          Your upcoming patient appointments will appear here.
        </p>

      </div>

    <% end %>

  </div>


  <!-- Past Appointments -->
  <div style="
    background:white;
    padding:30px;
    border-radius:16px;
    box-shadow:0 4px 18px rgba(0,0,0,0.06);
    margin-bottom:30px;
  ">

    <div style="margin-bottom:25px;">

      <h2 style="
        margin:0 0 5px 0;
        font-size:23px;
        color:#222;
      ">
        Past Appointments
      </h2>

      <p style="
        margin:0;
        color:#888;
        font-size:14px;
      ">
        Previous consultations
      </p>

    </div>


    <% if @past_appointments.any? %>

      <% @past_appointments.each do |appointment| %>

        <div style="
          border:1px solid #eee;
          border-radius:12px;
          padding:20px;
          margin-bottom:12px;
          display:flex;
          justify-content:space-between;
          align-items:center;
        ">

          <div>

            <h3 style="
              margin:0 0 6px 0;
              font-size:17px;
            ">
              <%= appointment.patient.name %>
            </h3>

            <p style="
              margin:0;
              color:#777;
              font-size:14px;
            ">
              <%= appointment.scheduled_at.strftime("%d %B %Y") %>
              &nbsp; • &nbsp;
              <%= appointment.scheduled_at.strftime("%I:%M %p") %>
            </p>

          </div>

          <span style="
            display:inline-block;
            padding:6px 13px;
            background:#f5f5f5;
            color:#555;
            border-radius:20px;
            font-size:12px;
            font-weight:bold;
          ">
            <%= appointment.status.humanize %>
          </span>

        </div>

      <% end %>

    <% else %>

      <!-- Empty Past State -->
      <div style="
        text-align:center;
        padding:40px 20px;
        border:1px dashed #ddd;
        border-radius:12px;
        background:#fafafa;
      ">

        <div style="
          font-size:45px;
          margin-bottom:12px;
        ">
          📋
        </div>

        <h3 style="
          margin:0 0 8px 0;
          color:#333;
        ">
          No past appointments
        </h3>

        <p style="
          margin:0;
          color:#888;
          font-size:14px;
        ">
          Completed appointments will appear here.
        </p>

      </div>

    <% end %>

  </div>


  <!-- Bottom Availability Section -->
  <div style="
    background:#1976d2;
    color:white;
    padding:28px 30px;
    border-radius:16px;
    display:flex;
    justify-content:space-between;
    align-items:center;
  ">

    <div>

      <h2 style="
        margin:0 0 8px 0;
        font-size:21px;
      ">
        Keep your availability updated
      </h2>

      <p style="
        margin:0;
        opacity:0.9;
        font-size:14px;
      ">
        Patients can only book appointments during your available hours.
      </p>

    </div>

    <%= link_to "Manage Availability →",
        doctor_doctor_availabilities_path(@doctor),
        style: "
          display:inline-block;
          padding:11px 18px;
          background:white;
          color:#1976d2;
          text-decoration:none;
          border-radius:8px;
          font-size:14px;
          font-weight:bold;
        " %>

  </div>

</div>