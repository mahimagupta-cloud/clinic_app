<div style="
  max-width:1200px;
  margin:0 auto;
  padding:40px 24px;
  font-family:Arial,sans-serif;
">

  <!-- Header -->
  <div style="margin-bottom:35px;">

    <p style="
      margin:0 0 8px;
      color:#1976d2;
      font-size:14px;
      font-weight:700;
      letter-spacing:0.5px;
    ">
      FIND YOUR CARE
    </p>

    <h1 style="
      margin:0 0 10px;
      font-size:34px;
      color:#1f2937;
    ">
      Find a Doctor
    </h1>

    <p style="
      margin:0;
      color:#6b7280;
      font-size:16px;
    ">
      Search for a doctor based on specialty, name, or location.
    </p>

  </div>


  <!-- Search -->
  <div style="
    background:white;
    padding:28px;
    border-radius:16px;
    border:1px solid #e5e7eb;
    box-shadow:0 2px 8px rgba(0,0,0,0.05);
    margin-bottom:35px;
  ">

    <h2 style="
      margin:0 0 20px;
      font-size:20px;
      color:#1f2937;
    ">
      Search Doctors
    </h2>

    <%= form_with url: doctors_path,
                  method: :get,
                  local: true do |f| %>

      <div style="
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
        gap:16px;
        align-items:end;
      ">

        <!-- Name -->
        <div>

          <%= f.label :name,
              "Doctor Name",
              style: "
                display:block;
                margin-bottom:7px;
                color:#374151;
                font-size:14px;
                font-weight:600;
              " %>

          <%= f.text_field :name,
              value: params[:name],
              placeholder: "e.g. Dr. Sharma",
              style: "
                width:100%;
                padding:12px 13px;
                border:1px solid #d1d5db;
                border-radius:8px;
                box-sizing:border-box;
                font-size:14px;
              " %>

        </div>


        <!-- Specialization -->
        <div>

          <%= f.label :specialization,
              "Specialization",
              style: "
                display:block;
                margin-bottom:7px;
                color:#374151;
                font-size:14px;
                font-weight:600;
              " %>

          <%= f.text_field :specialization,
              value: params[:specialization],
              placeholder: "e.g. Cardiologist",
              style: "
                width:100%;
                padding:12px 13px;
                border:1px solid #d1d5db;
                border-radius:8px;
                box-sizing:border-box;
                font-size:14px;
              " %>

        </div>


        <!-- Location -->
        <div>

          <%= f.label :location,
              "Location",
              style: "
                display:block;
                margin-bottom:7px;
                color:#374151;
                font-size:14px;
                font-weight:600;
              " %>

          <%= f.text_field :location,
              value: params[:location],
              placeholder: "e.g. Delhi",
              style: "
                width:100%;
                padding:12px 13px;
                border:1px solid #d1d5db;
                border-radius:8px;
                box-sizing:border-box;
                font-size:14px;
              " %>

        </div>


        <!-- Search -->
        <div>

          <%= f.submit "Search Doctors",
              style: "
                width:100%;
                padding:12px 18px;
                background:#1976d2;
                color:white;
                border:none;
                border-radius:8px;
                cursor:pointer;
                font-size:14px;
                font-weight:600;
              " %>

        </div>

      </div>

    <% end %>


    <!-- Clear -->
    <% if params[:name].present? ||
          params[:specialization].present? ||
          params[:location].present? %>

      <div style="margin-top:16px;">

        <%= link_to "Clear Search",
            doctors_path,
            style: "
              color:#1976d2;
              text-decoration:none;
              font-size:14px;
              font-weight:600;
            " %>

      </div>

    <% end %>

  </div>


  <!-- Results Heading -->
  <div style="
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:18px;
    gap:15px;
  ">

    <div>

      <h2 style="
        margin:0 0 5px;
        font-size:22px;
        color:#1f2937;
      ">
        Available Doctors
      </h2>

      <p style="
        margin:0;
        color:#6b7280;
        font-size:14px;
      ">
        <%= @doctors.count %>
        <%= @doctors.count == 1 ? "doctor" : "doctors" %>
        found
      </p>

    </div>

  </div>


  <!-- Doctors -->
  <% if @doctors.any? %>

    <div style="
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
      gap:22px;
    ">

      <% @doctors.each do |doctor| %>

        <div style="
          background:white;
          border:1px solid #e5e7eb;
          border-radius:16px;
          padding:25px;
          box-shadow:0 2px 8px rgba(0,0,0,0.05);
        ">

          <!-- Doctor Header -->
          <div style="
            display:flex;
            align-items:center;
            gap:15px;
            margin-bottom:20px;
          ">

            <div style="
              width:62px;
              height:62px;
              border-radius:50%;
              background:#e8f3ff;
              display:flex;
              align-items:center;
              justify-content:center;
              font-size:29px;
              flex-shrink:0;
            ">
              👨‍⚕️
            </div>

            <div>

              <h3 style="
                margin:0 0 5px;
                font-size:20px;
                color:#1f2937;
              ">
                Dr. <%= doctor.name %>
              </h3>

              <p style="
                margin:0;
                color:#1976d2;
                font-size:14px;
                font-weight:600;
              ">
                <%= doctor.specialization %>
              </p>

            </div>

          </div>


          <!-- Details -->
          <div style="
            border-top:1px solid #f0f0f0;
            padding-top:17px;
          ">

            <% if doctor.experience.present? %>

              <p style="
                margin:8px 0;
                color:#4b5563;
                font-size:14px;
              ">
                <strong>Experience:</strong>
                <%= doctor.experience %> years
              </p>

            <% end %>


            <p style="
              margin:8px 0;
              color:#4b5563;
              font-size:14px;
            ">
              <strong>📍 Location:</strong>
              <%= doctor.location.presence || "Not available" %>
            </p>


            <div style="
              margin-top:18px;
              padding:13px;
              background:#f8fafc;
              border-radius:9px;
            ">

              <span style="
                color:#6b7280;
                font-size:12px;
              ">
                CONSULTATION FEE
              </span>

              <div style="
                margin-top:3px;
                font-size:20px;
                font-weight:700;
                color:#1f2937;
              ">
                ₹<%= doctor.consultation_fee %>

                <span style="
                  font-size:12px;
                  font-weight:400;
                  color:#6b7280;
                ">
                  / consultation
                </span>
              </div>

            </div>

          </div>


          <!-- Actions -->
          <div style="
            display:flex;
            gap:10px;
            margin-top:20px;
          ">

            <%= link_to "View Profile",
                doctor_path(doctor),
                style: "
                  flex:1;
                  text-align:center;
                  padding:11px 12px;
                  background:white;
                  color:#1976d2;
                  border:1px solid #1976d2;
                  text-decoration:none;
                  border-radius:8px;
                  font-size:14px;
                  font-weight:600;
                  box-sizing:border-box;
                " %>


            <%= link_to "Book Appointment",
                doctor_path(doctor),
                style: "
                  flex:1;
                  text-align:center;
                  padding:11px 12px;
                  background:#1976d2;
                  color:white;
                  text-decoration:none;
                  border-radius:8px;
                  font-size:14px;
                  font-weight:600;
                  box-sizing:border-box;
                " %>

          </div>

        </div>

      <% end %>

    </div>


  <% else %>

    <!-- No Results -->
    <div style="
      text-align:center;
      background:white;
      padding:60px 25px;
      border-radius:16px;
      border:1px solid #e5e7eb;
      box-shadow:0 2px 8px rgba(0,0,0,0.05);
    ">

      <div style="
        font-size:48px;
        margin-bottom:15px;
      ">
        🔍
      </div>

      <h2 style="
        margin:0 0 10px;
        color:#1f2937;
      ">
        No doctors found
      </h2>

      <p style="
        margin:0 0 20px;
        color:#6b7280;
      ">
        Try changing your name, specialization, or location search.
      </p>

      <%= link_to "View All Doctors",
          doctors_path,
          style: "
            display:inline-block;
            padding:11px 20px;
            background:#1976d2;
            color:white;
            text-decoration:none;
            border-radius:8px;
            font-weight:600;
          " %>

    </div>

  <% end %>

</div>