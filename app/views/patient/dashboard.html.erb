<div style="
  max-width: 1100px;
  margin: 40px auto;
  padding: 0 20px;
">

  <!-- Header -->
  <div style="
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
  ">

    <div>
      <h1 style="margin: 0 0 8px 0;">
        Patient Dashboard
      </h1>

      <p style="color: #666; margin: 0;">
        Welcome back, <%= @patient.name %>
      </p>
    </div>

    <%= link_to "Find a Doctor",
        doctors_path,
        style: "
          display:inline-block;
          padding:10px 18px;
          background:#1976d2;
          color:white;
          text-decoration:none;
          border-radius:7px;
        " %>

  </div>


  <!-- Profile -->
  <div style="
    background:white;
    padding:25px;
    border-radius:14px;
    box-shadow:0 3px 15px rgba(0,0,0,0.08);
    margin-bottom:25px;
  ">

    <h2 style="margin-top:0;">
      My Profile
    </h2>

    <p>
      <strong>Name:</strong>
      <%= @patient.name %>
    </p>

    <p>
      <strong>Email:</strong>
      <%= current_user.email %>
    </p>

    <p>
      <strong>Phone:</strong>
      <%= @patient.phone %>
    </p>

  </div>


  <!-- Statistics -->
  <div style="
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
    margin-bottom:30px;
  ">

    <!-- Upcoming -->
    <div style="
      background:white;
      padding:25px;
      border-radius:14px;
      box-shadow:0 3px 15px rgba(0,0,0,0.08);
      text-align:center;
    ">

      <h2 style="margin:0;">
        <%= @upcoming_appointments.count %>
      </h2>

      <p style="color:#666;">
        Upcoming appointments
      </p>

    </div>


    <!-- Total -->
    <div style="
      background:white;
      padding:25px;
      border-radius:14px;
      box-shadow:0 3px 15px rgba(0,0,0,0.08);
      text-align:center;
    ">

      <h2 style="margin:0;">
        <%= @appointments.count %>
      </h2>

      <p style="color:#666;">
        Total appointments
      </p>

    </div>

  </div>


  <!-- Upcoming Appointments -->
  <div style="
    background:white;
    padding:25px;
    border-radius:14px;
    box-shadow:0 3px 15px rgba(0,0,0,0.08);
    margin-bottom:30px;
  ">

    <div style="
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:20px;
    ">

      <h2 style="margin:0;">
        Upcoming Appointments
      </h2>

  
    </div>


    <% if @upcoming_appointments.any? %>

      <% @upcoming_appointments.each do |appointment| %>

        <div style="
          border:1px solid #eee;
          padding:20px;
          border-radius:10px;
          margin-bottom:15px;
        ">

          <h3 style="margin-top:0;">
            Dr. <%= appointment.doctor.name %>
          </h3>

          <p>
            <strong>Specialization:</strong>
            <%= appointment.doctor.specialization %>
          </p>

          <p>
            <strong>Date:</strong>
            <%= appointment.scheduled_at.strftime("%d %B %Y") %>
          </p>

          <p>
            <strong>Time:</strong>
            <%= appointment.scheduled_at.strftime("%I:%M %p") %>
          </p>

          <p>
            <strong>Status:</strong>
            <%= appointment.status.humanize %>
          </p>

        </div>

      <% end %>

    <% else %>

      <div style="
        text-align:center;
        padding:30px 10px;
      ">

        <p style="color:#666;">
          You don't have any upcoming appointments.
        </p>

     
      </div>

    <% end %>

  </div>


  <!-- Past Appointments -->
  <div style="
    background:white;
    padding:25px;
    border-radius:14px;
    box-shadow:0 3px 15px rgba(0,0,0,0.08);
    margin-bottom:30px;
  ">

    <h2 style="margin-top:0;">
      Past Appointments
    </h2>


    <% if @past_appointments.any? %>

      <% @past_appointments.each do |appointment| %>

        <div style="
          border:1px solid #eee;
          padding:20px;
          border-radius:10px;
          margin-bottom:15px;
        ">

          <h3 style="margin-top:0;">
            Dr. <%= appointment.doctor.name %>
          </h3>

          <p>
            <strong>Specialization:</strong>
            <%= appointment.doctor.specialization %>
          </p>

          <p>
            <strong>Date:</strong>
            <%= appointment.scheduled_at.strftime("%d %B %Y") %>
          </p>

          <p>
            <strong>Time:</strong>
            <%= appointment.scheduled_at.strftime("%I:%M %p") %>
          </p>

          <p>
            <strong>Status:</strong>
            <%= appointment.status.humanize %>
          </p>

        </div>

      <% end %>

    <% else %>

      <p style="color:#666;">
        No past appointments.
      </p>

    <% end %>

  </div>


  <!-- Bottom CTA -->
  <div style="
    background:white;
    padding:35px;
    border-radius:14px;
    box-shadow:0 3px 15px rgba(0,0,0,0.08);
    text-align:center;
  ">

    <h2>
      Need another consultation?
    </h2>

    <p style="color:#666;">
      Find a doctor and book your next appointment.
    </p>

    <%= link_to "Find a Doctor",
        doctors_path,
        style: "
          display:inline-block;
          margin-top:10px;
          padding:11px 22px;
          background:#1976d2;
          color:white;
          text-decoration:none;
          border-radius:7px;
        " %>

  </div>

</div>