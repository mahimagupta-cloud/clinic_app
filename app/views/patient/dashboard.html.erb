<div style="
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 24px;
  font-family: Arial, sans-serif;
">

  <!-- Header -->
  <div style="
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    margin-bottom:35px;
    flex-wrap:wrap;
  ">

    <div>
      <p style="
        margin:0 0 8px;
        color:#1976d2;
        font-weight:600;
        font-size:14px;
      ">
        PATIENT PORTAL
      </p>

      <h1 style="
        margin:0 0 8px;
        font-size:32px;
        color:#1f2937;
      ">
        Welcome back, <%= @patient.name %> 👋
      </h1>

      <p style="
        margin:0;
        color:#6b7280;
        font-size:16px;
      ">
        Manage your appointments and find the right doctor for your care.
      </p>
    </div>

    <%= link_to "＋ Find a Doctor",
        doctors_path,
        style: "
          display:inline-block;
          padding:13px 22px;
          background:#1976d2;
          color:white;
          text-decoration:none;
          border-radius:9px;
          font-weight:600;
          font-size:15px;
        " %>

  </div>


  <!-- Statistics -->
  <div style="
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
    gap:20px;
    margin-bottom:30px;
  ">

    <!-- Upcoming -->
    <div style="
      background:white;
      padding:25px;
      border-radius:14px;
      border:1px solid #e5e7eb;
      box-shadow:0 2px 8px rgba(0,0,0,0.05);
    ">

      <p style="
        margin:0 0 10px;
        color:#6b7280;
        font-size:14px;
      ">
        Upcoming Appointments
      </p>

      <h2 style="
        margin:0;
        font-size:32px;
        color:#1976d2;
      ">
        <%= @upcoming_appointments.count %>
      </h2>

    </div>


    <!-- Total -->
    <div style="
      background:white;
      padding:25px;
      border-radius:14px;
      border:1px solid #e5e7eb;
      box-shadow:0 2px 8px rgba(0,0,0,0.05);
    ">

      <p style="
        margin:0 0 10px;
        color:#6b7280;
        font-size:14px;
      ">
        Total Appointments
      </p>

      <h2 style="
        margin:0;
        font-size:32px;
        color:#1f2937;
      ">
        <%= @appointments.count %>
      </h2>

    </div>

  </div>


  <!-- Profile -->
  <div style="
    background:white;
    padding:28px;
    border-radius:14px;
    border:1px solid #e5e7eb;
    box-shadow:0 2px 8px rgba(0,0,0,0.05);
    margin-bottom:30px;
  ">

    <div style="
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:20px;
    ">

      <div>
        <h2 style="
          margin:0 0 5px;
          color:#1f2937;
        ">
          My Profile
        </h2>

        <p style="
          margin:0;
          color:#6b7280;
          font-size:14px;
        ">
          Your registered information
        </p>
      </div>

    </div>


    <div style="
      display:grid;
      grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
      gap:20px;
    ">

      <div>
        <p style="margin:0 0 5px; color:#6b7280; font-size:13px;">
          NAME
        </p>

        <p style="margin:0; font-weight:600; color:#1f2937;">
          <%= @patient.name %>
        </p>
      </div>


      <div>
        <p style="margin:0 0 5px; color:#6b7280; font-size:13px;">
          EMAIL
        </p>

        <p style="margin:0; font-weight:600; color:#1f2937;">
          <%= current_user.email %>
        </p>
      </div>


      <div>
        <p style="margin:0 0 5px; color:#6b7280; font-size:13px;">
          PHONE
        </p>

        <p style="margin:0; font-weight:600; color:#1f2937;">
          <%= @patient.phone %>
        </p>
      </div>

    </div>

  </div>


  <!-- Upcoming Appointments -->
  <div style="
    background:white;
    padding:28px;
    border-radius:14px;
    border:1px solid #e5e7eb;
    box-shadow:0 2px 8px rgba(0,0,0,0.05);
    margin-bottom:30px;
  ">

    <div style="
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:22px;
    ">

      <div>
        <h2 style="
          margin:0 0 5px;
          color:#1f2937;
        ">
          Upcoming Appointments
        </h2>

        <p style="
          margin:0;
          color:#6b7280;
          font-size:14px;
        ">
          Your scheduled consultations
        </p>
      </div>

    </div>


    <% if @upcoming_appointments.any? %>

      <% @upcoming_appointments.each do |appointment| %>

        <div style="
          border:1px solid #e5e7eb;
          border-radius:12px;
          padding:22px;
          margin-bottom:15px;
        ">

          <div style="
            display:flex;
            justify-content:space-between;
            align-items:flex-start;
            gap:20px;
            flex-wrap:wrap;
          ">

            <div>

              <h3 style="
                margin:0 0 8px;
                color:#1f2937;
                font-size:20px;
              ">
                Dr. <%= appointment.doctor.name %>
              </h3>

              <p style="
                margin:0 0 14px;
                color:#1976d2;
                font-weight:600;
              ">
                <%= appointment.doctor.specialization %>
              </p>

              <p style="
                margin:6px 0;
                color:#4b5563;
              ">
                📅
                <strong>Date:</strong>
                <%= appointment.scheduled_at.strftime("%d %B %Y") %>
              </p>

              <p style="
                margin:6px 0;
                color:#4b5563;
              ">
                🕐
                <strong>Time:</strong>
                <%= appointment.scheduled_at.strftime("%I:%M %p") %>
              </p>

              <p style="
                margin:6px 0;
                color:#4b5563;
              ">
                📍
                <strong>Location:</strong>
                <%= appointment.doctor.location.presence || "Not available" %>
              </p>

            </div>


            <div style="
              text-align:right;
            ">

              <span style="
                display:inline-block;
                padding:6px 12px;
                border-radius:20px;
                background:#e8f5e9;
                color:#2e7d32;
                font-size:13px;
                font-weight:600;
              ">
                <%= appointment.status.humanize %>
              </span>


              <% if appointment.scheduled? && appointment.scheduled_at > Time.current %>

                <div style="margin-top:15px;">

                  <%= button_to "Cancel Appointment",
                      cancel_appointment_path(appointment),
                      method: :patch,
                      data: {
                        turbo_confirm: "Are you sure you want to cancel this appointment?"
                      },
                      style: "
                        padding:9px 14px;
                        background:white;
                        color:#dc2626;
                        border:1px solid #dc2626;
                        border-radius:7px;
                        font-weight:600;
                        cursor:pointer;
                      " %>

                </div>

              <% end %>

            </div>

          </div>

        </div>

      <% end %>

    <% else %>

      <div style="
        text-align:center;
        padding:45px 20px;
        border:1px dashed #d1d5db;
        border-radius:12px;
      ">

        <div style="
          font-size:40px;
          margin-bottom:12px;
        ">
          📅
        </div>

        <h3 style="
          margin:0 0 8px;
          color:#1f2937;
        ">
          No upcoming appointments
        </h3>

        <p style="
          margin:0 0 20px;
          color:#6b7280;
        ">
          Find a doctor and schedule your next consultation.
        </p>

        <%= link_to "Find a Doctor",
            doctors_path,
            style: "
              display:inline-block;
              padding:11px 18px;
              background:#1976d2;
              color:white;
              text-decoration:none;
              border-radius:7px;
              font-weight:600;
            " %>

      </div>

    <% end %>

  </div>


  <!-- Past Appointments -->
  <div style="
    background:white;
    padding:28px;
    border-radius:14px;
    border:1px solid #e5e7eb;
    box-shadow:0 2px 8px rgba(0,0,0,0.05);
    margin-bottom:30px;
  ">

    <h2 style="
      margin:0 0 5px;
      color:#1f2937;
    ">
      Past Appointments
    </h2>

    <p style="
      margin:0 0 22px;
      color:#6b7280;
      font-size:14px;
    ">
      Your previous consultations
    </p>


    <% if @past_appointments.any? %>

      <% @past_appointments.each do |appointment| %>

        <div style="
          border:1px solid #e5e7eb;
          border-radius:12px;
          padding:20px;
          margin-bottom:14px;
        ">

          <h3 style="
            margin:0 0 6px;
            color:#1f2937;
          ">
            Dr. <%= appointment.doctor.name %>
          </h3>

          <p style="
            margin:0 0 12px;
            color:#1976d2;
            font-weight:600;
          ">
            <%= appointment.doctor.specialization %>
          </p>

          <p style="margin:6px 0; color:#4b5563;">
            📅
            <strong>Date:</strong>
            <%= appointment.scheduled_at.strftime("%d %B %Y") %>
          </p>

          <p style="margin:6px 0; color:#4b5563;">
            🕐
            <strong>Time:</strong>
            <%= appointment.scheduled_at.strftime("%I:%M %p") %>
          </p>

          <p style="margin:6px 0; color:#4b5563;">
            <strong>Status:</strong>
            <%= appointment.status.humanize %>
          </p>

        </div>

      <% end %>

    <% else %>

      <p style="
        color:#6b7280;
        margin:0;
      ">
        No past appointments.
      </p>

    <% end %>

  </div>


  <!-- Bottom CTA -->
  <div style="
    background:#f5f9ff;
    padding:35px 25px;
    border-radius:14px;
    border:1px solid #dbeafe;
    text-align:center;
  ">

    <h2 style="
      margin:0 0 10px;
      color:#1f2937;
    ">
      Need another consultation?
    </h2>

    <p style="
      margin:0 0 20px;
      color:#6b7280;
    ">
      Browse available doctors and book your next appointment.
    </p>

    <%= link_to "Find a Doctor",
        doctors_path,
        style: "
          display:inline-block;
          padding:12px 22px;
          background:#1976d2;
          color:white;
          text-decoration:none;
          border-radius:8px;
          font-weight:600;
        " %>

  </div>

</div>