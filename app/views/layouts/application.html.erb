<!DOCTYPE html>

<html>
  <head>
    <title><%= content_for(:title) || "Clinic App" %></title>

```
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="application-name" content="Clinic App">
<meta name="mobile-web-app-capable" content="yes">

<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%= yield :head %>

<link rel="icon" href="/icon.png" type="image/png">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icon.png">

<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>
```

  </head>

  <body>

```
<!-- Navigation -->

<nav style="
  padding: 15px 30px;
  background: #f5f5f5;
  border-bottom: 1px solid #ddd;
  display: flex;
  align-items: center;
  gap: 20px;
">

  <%= link_to "Clinic App", root_path,
      style: "font-size: 20px; font-weight: bold; text-decoration: none;" %>

  <% if user_signed_in? %>

    <span>
      Logged in as:
      <strong><%= current_user.email %></strong>
    </span>

    <% if current_user.admin? %>

      <%= link_to "Admin Dashboard",
          admin_dashboard_path %>

    <% elsif current_user.patient? %>

      <%= link_to "Patient Dashboard",
          patient_dashboard_path %>

    <% end %>

    <%= button_to "Logout",
        destroy_user_session_path,
        method: :delete %>

  <% else %>

    <%= link_to "Login",
        new_user_session_path %>

    <%= link_to "Sign Up",
        new_user_registration_path %>

  <% end %>

</nav>


<!-- Flash Messages -->

<% if notice %>
  <p style="padding: 10px; background: #e8f5e9;">
    <%= notice %>
  </p>
<% end %>

<% if alert %>
  <p style="padding: 10px; background: #ffebee;">
    <%= alert %>
  </p>
<% end %>


<!-- Page Content -->

<main>
  <%= yield %>
</main>
```

  </body>
</html>
