<div style="
  max-width:900px;
  margin:0 auto;
  padding:40px 24px;
  font-family:Arial,sans-serif;
">

  <!-- Header -->
  <div style="margin-bottom:30px;">

    <p style="
      margin:0 0 8px;
      color:#1976d2;
      font-size:13px;
      font-weight:700;
      letter-spacing:0.5px;
    ">
      SECURE CHECKOUT
    </p>

    <h1 style="
      margin:0 0 8px;
      color:#1f2937;
      font-size:32px;
    ">
      Complete Your Payment
    </h1>

    <p style="
      margin:0;
      color:#6b7280;
      font-size:15px;
    ">
      Review your appointment details before proceeding to payment.
    </p>

  </div>


  <!-- Main Layout -->
  <div style="
    display:grid;
    grid-template-columns:1.4fr 0.8fr;
    gap:24px;
    align-items:start;
  ">


    <!-- Appointment Details -->
    <div style="
      background:white;
      border:1px solid #e5e7eb;
      border-radius:16px;
      padding:28px;
      box-shadow:0 2px 8px rgba(0,0,0,0.05);
    ">

      <h2 style="
        margin:0 0 22px;
        color:#1f2937;
        font-size:21px;
      ">
        Appointment Details
      </h2>


      <!-- Doctor -->
      <div style="
        display:flex;
        align-items:center;
        gap:15px;
        padding-bottom:22px;
        border-bottom:1px solid #f0f0f0;
      ">

        <div style="
          width:60px;
          height:60px;
          border-radius:50%;
          background:#e8f3ff;
          display:flex;
          align-items:center;
          justify-content:center;
          font-size:28px;
          flex-shrink:0;
        ">
          👨‍⚕️
        </div>

        <div>

          <p style="
            margin:0 0 5px;
            color:#1976d2;
            font-size:13px;
            font-weight:600;
          ">
            DOCTOR
          </p>

          <h3 style="
            margin:0;
            color:#1f2937;
            font-size:20px;
          ">
            Dr. <%= @appointment.doctor.name %>
          </h3>

          <p style="
            margin:5px 0 0;
            color:#6b7280;
            font-size:14px;
          ">
            <%= @appointment.doctor.specialization %>
          </p>

        </div>

      </div>


      <!-- Appointment Information -->
      <div style="
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
        gap:20px;
        padding-top:22px;
      ">


        <div>

          <p style="
            margin:0 0 6px;
            color:#6b7280;
            font-size:12px;
            font-weight:600;
          ">
            DATE & TIME
          </p>

          <p style="
            margin:0;
            color:#1f2937;
            font-size:15px;
            font-weight:700;
          ">
            📅 <%= @appointment.scheduled_at.strftime("%d %B %Y") %>
          </p>

          <p style="
            margin:4px 0 0;
            color:#6b7280;
            font-size:14px;
          ">
            <%= @appointment.scheduled_at.strftime("%I:%M %p") %>
          </p>

        </div>


        <div>

          <p style="
            margin:0 0 6px;
            color:#6b7280;
            font-size:12px;
            font-weight:600;
          ">
            LOCATION
          </p>

          <p style="
            margin:0;
            color:#1f2937;
            font-size:15px;
            font-weight:700;
          ">
            📍 <%= @appointment.doctor.location.presence || "Not available" %>
          </p>

        </div>


        <div>

          <p style="
            margin:0 0 6px;
            color:#6b7280;
            font-size:12px;
            font-weight:600;
          ">
            PAYMENT STATUS
          </p>

          <span style="
            display:inline-block;
            padding:6px 10px;
            background:#fff7ed;
            color:#c2410c;
            border-radius:6px;
            font-size:12px;
            font-weight:700;
          ">
            <%= @payment.status.humanize.upcase %>
          </span>

        </div>

      </div>

    </div>


    <!-- Payment Summary -->
    <div style="
      background:white;
      border:1px solid #e5e7eb;
      border-radius:16px;
      padding:28px;
      box-shadow:0 2px 8px rgba(0,0,0,0.05);
      position:sticky;
      top:20px;
    ">

      <h2 style="
        margin:0 0 22px;
        color:#1f2937;
        font-size:21px;
      ">
        Payment Summary
      </h2>


      <div style="
        display:flex;
        justify-content:space-between;
        align-items:center;
        padding-bottom:16px;
        border-bottom:1px solid #f0f0f0;
      ">

        <span style="
          color:#6b7280;
          font-size:14px;
        ">
          Consultation Fee
        </span>

        <strong style="
          color:#1f2937;
          font-size:16px;
        ">
          ₹<%= @payment.amount %>
        </strong>

      </div>


      <div style="
        display:flex;
        justify-content:space-between;
        align-items:center;
        padding:18px 0 22px;
      ">

        <span style="
          color:#374151;
          font-size:16px;
          font-weight:700;
        ">
          Total Amount
        </span>

        <span style="
          color:#1976d2;
          font-size:25px;
          font-weight:800;
        ">
          ₹<%= @payment.amount %>
        </span>

      </div>


      <!-- Pay Button -->
      <button
        id="pay-button"
        style="
          width:100%;
          background:#1976d2;
          color:white;
          border:none;
          border-radius:9px;
          padding:14px 20px;
          font-size:15px;
          font-weight:700;
          cursor:pointer;
        "
      >
        Pay ₹<%= @payment.amount %> Securely
      </button>


      <!-- Security Note -->
      <div style="
        margin-top:16px;
        padding:12px;
        background:#f8fafc;
        border-radius:8px;
        text-align:center;
      ">

        <p style="
          margin:0;
          color:#6b7280;
          font-size:12px;
          line-height:1.5;
        ">
          🔒 Secure payment powered by Razorpay
        </p>

      </div>

    </div>

  </div>


  <!-- Footer Note -->
  <div style="
    margin-top:22px;
    padding:16px 18px;
    background:#eff6ff;
    border:1px solid #dbeafe;
    border-radius:10px;
  ">

    <p style="
      margin:0;
      color:#374151;
      font-size:13px;
      line-height:1.5;
    ">
      Your appointment will be confirmed after successful payment.
      A confirmation email will be sent to your registered email address.
    </p>

  </div>

</div>


<!-- Razorpay Checkout -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
  document.getElementById("pay-button").addEventListener("click", function () {

    const options = {
      key: "<%= ENV.fetch("RAZORPAY_KEY_ID") %>",
      amount: <%= (@payment.amount * 100).to_i %>,
      currency: "INR",
      name: "Clinic App",
      description: "Appointment with <%= j @appointment.doctor.name %>",
      order_id: "<%= @payment.gateway_order_id %>",

      handler: function (response) {

        fetch("<%= verify_payment_path %>", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-Token": document.querySelector(
              'meta[name="csrf-token"]'
            ).content
          },

          body: JSON.stringify({
            razorpay_payment_id: response.razorpay_payment_id,
            razorpay_order_id: response.razorpay_order_id,
            razorpay_signature: response.razorpay_signature,
            appointment_id: "<%= @appointment.id %>"
          })
        })
        .then(response => response.json())
        .then(data => {

          if (data.success) {
            window.location.href =
              "<%= appointment_path(@appointment) %>";
          } else {
            alert(data.error || "Payment verification failed.");
          }

        })
        .catch(() => {
          alert("Something went wrong while verifying the payment.");
        });
      },

      modal: {
        ondismiss: function () {
          console.log("Payment window closed.");
        }
      },

      theme: {
        color: "#1976d2"
      }
    };

    const razorpay = new Razorpay(options);

    razorpay.open();
  });
</script>